# Copy to .env and fill in. NEVER commit .env. Values below are placeholders only.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
JWT_SECRET=generate-a-long-random-string   # e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
FRONTEND_URL=http://localhost:5173

# AI agent: "mock" works offline with no key. Use "openai" for any OpenAI-compatible API.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
